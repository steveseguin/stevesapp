# Steve's App Configuration

# Secret token for API authentication (generate a secure random string)
API_TOKEN=your-secret-token-here

# Server port
PORT=3000

# Default terminal dimensions
DEFAULT_COLS=120
DEFAULT_ROWS=30

# Scrollback buffer size (lines)
SCROLLBACK=10000

# VDO.Ninja P2P relay settings
VDO_SERVER=true
VDO_ROOM=steves-app
VDO_PASSWORD=your-secret-token-here
VDO_STREAM_ID=host
VDO_DEBUG=false
