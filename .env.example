# Terminal Hub Configuration

# Secret token for API authentication (generate a secure random string)
API_TOKEN=your-secret-token-here

# Server port
PORT=3000

# Default terminal dimensions
DEFAULT_COLS=120
DEFAULT_ROWS=30

# Scrollback buffer size (lines)
SCROLLBACK=10000

# VDO relay settings (server-side data channel)
VDO_SERVER=true
VDO_ROOM=terminal-hub
VDO_PASSWORD=your-secret-token-here
VDO_STREAM_ID=host
VDO_DEBUG=false
